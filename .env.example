# Copy this file to .env and adjust if needed. .env is git-ignored.
# All values below are safe local-development defaults, not real secrets.

# ---- MongoDB ----
# No auth locally (single-node replica set, not exposed beyond the host -
# see infrastructure/docker/docker-compose.yml). A real environment
# (MongoDB Atlas) is always authenticated.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- LocalStack (fake AWS credentials, required by AWS SDKs but not real) ----
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ---- JWT ----
# RS256, not a shared secret - identity-service signs with an RSA private key
# (backend/identity-service/src/main/resources/privateKey.pem, a committed
# dev/test fixture, never a production secret) and every other service
# verifies with the matching public key. Nothing to configure here - see
# docs/adr/0006-rbac-roles.md.
