# Copy this file to .env and adjust if needed. .env is git-ignored.
# All values below are safe local-development defaults, not real secrets.

# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=travel_platform
MONGO_INITDB_ROOT_PASSWORD=local_dev_only
MONGO_URI=mongodb://travel_platform:local_dev_only@localhost:27017

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- LocalStack (fake AWS credentials, required by AWS SDKs but not real) ----
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ---- JWT (generate a real local-only value with: openssl rand -base64 64) ----
JWT_ISSUER=travel-platform-local
JWT_SECRET=replace_me_with_a_generated_local_only_secret
